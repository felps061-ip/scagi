# Autenticação do próprio SCAGI. Todos os usuários compartilham e podem conectar os portais.
APP_USERS_JSON=[{"username":"admin","password":"troque-esta-senha","role":"admin"},{"username":"vendedor1","password":"troque-a-senha-do-vendedor","role":"operator"}]
SESSION_SECRET=gere-uma-chave-longa-e-aleatoria

# mock mantém o sistema demonstrável sem acessar dados reais.
# Troque para real somente no servidor autorizado.
PORTAL_MODE=mock
PORTAL_CONSIGNADO_USERNAME=
PORTAL_CONSIGNADO_PASSWORD=
PORTAL_CONSIGNADO_GOV_SP_2_USERNAME=
PORTAL_CONSIGNADO_GOV_SP_2_PASSWORD=
PORTAL_PREFEITURA_SP_USERNAME=
PORTAL_PREFEITURA_SP_PASSWORD=
PORTAL_PIAUI_USERNAME=
PORTAL_PIAUI_PASSWORD=

# Use "chrome" para aproveitar o Chrome instalado no Windows.
# Deixe vazio se instalar o Chromium do Playwright.
PORTAL_BROWSER_CHANNEL=chrome
PLAYWRIGHT_HEADLESS=true

PORT=3000
HOST=127.0.0.1
